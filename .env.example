# Bondify Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL - change this for production
VITE_BACKEND_URL=http://localhost:8001

# ============================================
# MAP PROVIDER CONFIGURATION (optional)
# ============================================
# Available providers: openstreetmap, mapbox, maptiler, stadia, thunderforest
# Default: openstreetmap (free, no API key required)
VITE_MAP_PROVIDER=openstreetmap

# Mapbox (premium) - https://mapbox.com
# VITE_MAPBOX_TOKEN=your_mapbox_token

# MapTiler (freemium) - https://maptiler.com
# VITE_MAPTILER_KEY=your_maptiler_key

# Stadia Maps (freemium) - https://stadiamaps.com
# VITE_STADIA_KEY=your_stadia_key

# Thunderforest (freemium, good for transport) - https://thunderforest.com
# VITE_THUNDERFOREST_KEY=your_thunderforest_key
