# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/miparada

# Server Configuration
PORT=8001
# IMPORTANT: Never use * in production. List your allowed origins comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Emergent LLM Key (Universal key for OpenAI, Anthropic, Gemini)
# Get your key from the Emergent Agent dashboard
EMERGENT_LLM_KEY=

# API Keys (optional, Emergent key has priority)
API_KEY=
GEMINI_API_KEY=
