# NOTA: en dev, el .env se lee desde la RAÍZ del repo (npm start corre desde ahí).
# Este archivo documenta las variables del backend; copiá los valores a ../.env
# o exportalos en el entorno.

# Server Configuration
PORT=8001
# List your allowed origins comma-separated. NEVER use * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Secreto para firmar las cookies de sesión anónima (bfy_uid).
# OBLIGATORIO en producción (el server no arranca sin él).
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Gemini AI - Get your FREE key at: https://aistudio.google.com/apikey
# The key starts with "AIza..."
# Sin key, el análisis de reportes cae a un mock por keywords (solo dev).
GEMINI_API_KEY=

# Credenciales de Firebase Admin (producción): pegá el JSON entero del
# service account. En dev alcanza con tener server/serviceAccountKey.json.
# FIREBASE_CREDENTIALS=

# Solo para desarrollo: permite arrancar sin credenciales de Firebase
# usando una DB en memoria (se borra en cada restart). NUNCA en producción.
# ALLOW_MOCK_DB=true
